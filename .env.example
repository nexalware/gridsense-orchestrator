# Copy this file to .env and fill in local values.
# Never commit .env. Only .env.example belongs in git.
# Comments go on their own lines, never after a value.

# --- Database (PostgreSQL / PostGIS) ---
DB_USER=mobius4
# Required. Choose a password; it stays in your local .env.
DB_PW=
DB_NAME=mobius4
# The default image (postgis/postgis:17-3.5) is amd64-only.
# On Apple Silicon (arm64), uncomment this line to use a multi-arch build:
# POSTGRES_IMAGE=ghcr.io/baosystems/postgis:17

# --- oneM2M CSE (Mobius4, IN-CSE) ---
# Service name inside the compose network. The http:// prefix is required.
# Written to Mobius4's database on first start only; after a change run
# docker compose down -v.
CSE_POA=http://mobius4:7599
# Must match serviceProviderID in site-gateway/acme/acme.ini.
# Also written on first start only; a change needs docker compose down -v.
CSE_SP_ID=//gridsense.local
# Credential. Leave empty: Mobius4 generates one on first start.
# Read it with: docker compose logs mobius4 | grep -i admin
CSE_ADMIN=
# Mobius4 log level
LOG_LEVEL=info

# --- ACME (site MN-CSE) ---
# Credential. Empty uses ACME's built-in default, which ACME warns about.
# Set a real value before any shared deployment.
ACME_SECURITY_SECRET=
# ACME log level. debug also shows the 60 s registrar liveness check.
ACME_LOG_LEVEL=info

# --- Dashboard (server-side oneM2M access; never sent to the browser) ---
# CSE the dashboard talks to. Default: Mobius4 (IN-CSE), which forwards to ACME.
# For ACME direct use http://acme-site:8081. See dashboard/README.md.
ONEM2M_BASE_URL=http://mobius4:7599
# SP-relative path of the site CSEBase (ACME, /id-mn, cse-mn)
ONEM2M_CSE_PATH=/~/id-mn/cse-mn
# Dashboard AE originator. Must start with C (ACME allows C* and S* by default).
ONEM2M_ORIGINATOR=Cgridsense-dashboard

# --- Dev feed (DEV ONLY, docker compose --profile dev) ---
# Simulation speed. 2 shows a full outage and restart in under a minute.
DEV_FEED_SPEED=1
# Seconds between load starts in the staggered restart (at speed 1)
DEV_FEED_RESTART_GAP_S=10
# Optional: a load id that goes FAULT on restart, e.g. load-p2-machine
DEV_FEED_FAULT=
