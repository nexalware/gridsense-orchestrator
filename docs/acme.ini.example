; ACME site MN-CSE config for GridSense, registering to Mobius4 (IN-CSE).
; Generated by the acmecse onboarding wizard (acmecse 2026.05.3), plus the
; [cse.registrar] excludeCSRAttributes line. See cse-setup.md.
;
; Replace <your-LAN-IP> before use. Do not commit a real secret.

[basic.config]
cseType = MN
cseID = id-mn
cseName = cse-mn
; must match Mobius4's CSE_SP_ID
serviceProviderID = //gridsense.local
adminID = CAdmin
networkInterface = 0.0.0.0
cseHost = <your-LAN-IP>
registrarCseID = Mobius4
registrarCseName = Mobius
registrarCseHost = localhost
registrarCsePort = 7599
databaseType = tinydb
httpPort = 8081
consoleTheme = dark
consoleType = rich
logLevel = debug

[http]
enableManagementEndpoint = true

[textui]
enable = false

[cse.registration]
allowedCSROriginators = /id-in,/id-mn,/id-asn

[cse.registrar]
INCSEcseID = /Mobius4
; Mobius4 rejects spi/dcse/ici in a <remoteCSE> create, and its csz column
; is VARCHAR(10)[], too short for ACME's media-type values.
excludeCSRAttributes = spi,dcse,ici,csz

[http.wsgi]
enable = true
